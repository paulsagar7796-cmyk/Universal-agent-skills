{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills-brain.invalid/schemas/eval-cases.schema.json",
  "title": "Skill evaluation cases (evals/cases.yaml)",
  "type": "object",
  "required": ["schema_version", "skill", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "kind", "prompt", "expect"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["typical", "edge", "ambiguous", "unsupported-claim", "untrusted-input"] },
          "routing": { "type": "boolean", "description": "true = the router must select this skill for the prompt" },
          "prompt": { "type": "string" },
          "fixture": { "type": "string" },
          "expect": {
            "type": "object",
            "required": ["must"],
            "properties": { "must": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "must_not": { "type": "array", "items": { "type": "string" } } }
          }
        }
      }
    }
  }
}
